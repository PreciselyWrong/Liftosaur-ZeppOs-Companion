# WARNING: `zeus dev` overwrites this file with its own template on every run,
# which drops the secret patterns and the agent-file exclusions below.
# After running zeus dev, restore it: git checkout -- .gitignore

# Secrets and local configuration
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
config.local.json

